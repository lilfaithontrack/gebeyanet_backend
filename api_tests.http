### ============================================================
### GEBYA NET — Full Backend API Test Suite
### Base URL: http://localhost:3000
### VS Code: install "REST Client" extension, then click "Send Request"
### ============================================================

@base = http://localhost:3000
@adminToken = REPLACE_WITH_ADMIN_TOKEN
@userToken  = REPLACE_WITH_USER_TOKEN
@adminEmail = admin@gebyanet.com
@adminPass  = GebyaAdmin2026!


# ============================================================
# 1. ADMIN AUTH  (/api/admin)
# ============================================================

### 1.1 Register admin (superadmin creates another admin)
POST {{base}}/api/admin/register
Content-Type: application/json

{
  "name": "Test Admin",
  "email": "testadmin@gebyanet.com",
  "password": "TestAdmin123!",
  "role": "admin"
}

###

### 1.2 Admin Login  ← run this first, copy token into @adminToken above
POST {{base}}/api/admin/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPass}}"
}

###

### 1.3 Get all admins
GET {{base}}/api/admin
Authorization: Bearer {{adminToken}}

###

### 1.4 Get admin by ID
GET {{base}}/api/admin/1
Authorization: Bearer {{adminToken}}

###

### 1.5 Update admin
PUT {{base}}/api/admin/1
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Updated Admin Name"
}

###


# ============================================================
# 2. USER / SELLER AUTH  (/api/user)
# ============================================================

### 2.1 Register new user (buyer)
POST {{base}}/api/user/register
Content-Type: application/json

{
  "full_name": "Test Buyer",
  "email": "buyer@testgebya.com",
  "phone": "0911000001",
  "password": "Buyer123!",
  "role": "buyer"
}

###

### 2.2 Register new seller
POST {{base}}/api/user/register
Content-Type: application/json

{
  "full_name": "Test Seller",
  "email": "seller@testgebya.com",
  "phone": "0911000002",
  "password": "Seller123!",
  "role": "seller"
}

###

### 2.3 User Login  ← run this, copy token into @userToken above
POST {{base}}/api/user/login
Content-Type: application/json

{
  "email": "seller@testgebya.com",
  "password": "Seller123!"
}

###

### 2.4 Get my profile (authenticated user)
GET {{base}}/api/user/profile
Authorization: Bearer {{userToken}}

###

### 2.5 Get all users (admin)
GET {{base}}/api/user
Authorization: Bearer {{adminToken}}

###

### 2.6 Get user by ID (admin)
GET {{base}}/api/user/1
Authorization: Bearer {{adminToken}}

###

### 2.7 Update user status (admin)
PUT {{base}}/api/user/1/status
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "status": "active"
}

###

### 2.8 Upgrade to seller
POST {{base}}/api/user/upgrade-to-seller
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "seller_level": "reseller",
  "business_name": "My Test Shop"
}

###

### 2.9 Get referral stats (authenticated seller)
GET {{base}}/api/user/referral/stats
Authorization: Bearer {{userToken}}

###

### 2.10 Get admin referral stats
GET {{base}}/api/user/referral/admin-stats
Authorization: Bearer {{adminToken}}

###

### 2.11 Send OTP
POST {{base}}/api/user/send-otp
Content-Type: application/json

{
  "email": "buyer@testgebya.com"
}

###

### 2.12 Forgot password
POST {{base}}/api/user/forgot-password
Content-Type: application/json

{
  "email": "buyer@testgebya.com"
}

###


# ============================================================
# 3. PRODUCTS  (/api/prod)
# ============================================================

### 3.1 Get all products (public)
GET {{base}}/api/prod

###

### 3.2 Get product by ID
GET {{base}}/api/prod/1

###

### 3.3 Get products by location
GET {{base}}/api/prod/location?lat=9.0300&lng=38.7400&radius=10

###

### 3.4 Get my products (seller)
GET {{base}}/api/prod/my-products
Authorization: Bearer {{userToken}}

###

### 3.5 Create product (seller — JSON body, no file)
POST {{base}}/api/prod
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "title": "Test Product",
  "price": 150.00,
  "description": "A test product for API validation",
  "brand": "TestBrand",
  "catItems": "Electronics",
  "subcat": "Phones",
  "product_type": "reseller",
  "origin_country": "Ethiopia",
  "stock": "in_stock",
  "sell_unit": "piece",
  "min_order_qty": 1,
  "weight_kg": 0.5
}

###

### 3.6 Update product (seller/admin)
PUT {{base}}/api/prod/1
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "price": 175.00,
  "description": "Updated description"
}

###

### 3.7 Approve / reject product (admin)
PUT {{base}}/api/prod/1/status
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "status": "approved"
}

###

### 3.8 Delete product (seller/admin)
DELETE {{base}}/api/prod/1
Authorization: Bearer {{userToken}}

###


# ============================================================
# 4. CATEGORIES  (/api/category, /api/subcat, /api/catitem)
# ============================================================

### 4.1 Get all categories (public)
GET {{base}}/api/category

###

### 4.2 Create category (admin)
POST {{base}}/api/category/create
Content-Type: application/json

{
  "name": "Electronics",
  "description": "Electronic devices and accessories",
  "image": ""
}

###

### 4.3 Get category by ID
GET {{base}}/api/category/1

###

### 4.4 Update category (admin)
PUT {{base}}/api/category/1
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Electronics & Gadgets"
}

###

### 4.5 Delete category (admin)
DELETE {{base}}/api/category/1
Authorization: Bearer {{adminToken}}

###

### 4.6 Get all subcategories
GET {{base}}/api/subcat

###

### 4.7 Create subcategory
POST {{base}}/api/subcat/Create
Content-Type: application/json

{
  "name": "Smartphones",
  "category_id": 1
}

###

### 4.8 Get all category items
GET {{base}}/api/catitem

###

### 4.9 Create category item
POST {{base}}/api/catitem/create
Content-Type: application/json

{
  "name": "iPhone",
  "subcat_id": 1
}

###


# ============================================================
# 5. UOM (Unit of Measure)  (/api/uoms)
# ============================================================

### 5.1 Get UOMs for a product
GET {{base}}/api/uoms/1

###

### 5.2 Create UOM
POST {{base}}/api/uoms
Content-Type: application/json

{
  "product_id": 1,
  "unit_name": "piece",
  "price": 150.00,
  "min_order": 1
}

###

### 5.3 Update UOM
PUT {{base}}/api/uoms/1
Content-Type: application/json

{
  "price": 160.00
}

###

### 5.4 Delete UOM
DELETE {{base}}/api/uoms/1

###


# ============================================================
# 6. CART  (/api/cart)
# ============================================================

### 6.1 Add item to cart
POST {{base}}/api/cart/add-item
Content-Type: application/json

{
  "user_id": 1,
  "product_id": 1,
  "quantity": 2,
  "price": 150.00
}

###

### 6.2 Get all cart items
GET {{base}}/api/cart/cart-items

###

### 6.3 Get cart item by ID
GET {{base}}/api/cart/cart-items/1

###

### 6.4 Delete cart item
DELETE {{base}}/api/cart/cart-items/1

###


# ============================================================
# 7. ORDERS  (/api/order)
# ============================================================

### 7.1 Create order
POST {{base}}/api/order/create
Content-Type: application/json

{
  "user_id": 1,
  "items": [{"product_id": 1, "quantity": 2, "price": 150.00}],
  "total": 300.00,
  "delivery_address": "Addis Ababa, Bole"
}

###

### 7.2 Get order by ID
GET {{base}}/api/order/order/1

###

### 7.3 Get all orders for a user
GET {{base}}/api/order/orders/user/1

###

### 7.4 Process payment for order
POST {{base}}/api/order/payment
Content-Type: application/json

{
  "order_id": 1,
  "payment_method": "cash"
}

###

### 7.5 Delete order
DELETE {{base}}/api/order/order/1

###


# ============================================================
# 8. PAYMENTS  (/api/payments)
# ============================================================

### 8.1 Create payment
POST {{base}}/api/payments/create
Content-Type: application/json

{
  "shopper_id": 1,
  "total_price": 300.00,
  "delivery_address": "Addis Ababa, Bole",
  "items": [{"product_id": 1, "quantity": 2, "price": 150.00}],
  "lat": 9.0300,
  "lng": 38.7400
}

###

### 8.2 Get available orders (delivery boys)
GET {{base}}/api/payments/available

###

### 8.3 Get all orders (admin)
GET {{base}}/api/payments/orders

###

### 8.4 Get order by payment ID
GET {{base}}/api/payments/orders/1

###

### 8.5 Get order history
GET {{base}}/api/payments/orders/history

###

### 8.6 Update payment status
PUT {{base}}/api/payments/update-status/1
Content-Type: application/json

{
  "status": "confirmed"
}

###

### 8.7 Cancel order (user)
PUT {{base}}/api/payments/cancel/1
Authorization: Bearer {{userToken}}

###

### 8.8 Assign nearby delivery
POST {{base}}/api/payments/assign-nearby/1
Content-Type: application/json

{}

###


