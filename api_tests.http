# ============================================================
# 16. WALLET & WITHDRAWALS  (/api/withdraw)
# ============================================================

### 16.1 Seller requests withdrawal
POST {{base}}/api/withdraw/request
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "amount": 500
}

###

### 16.2 Seller views own withdrawals
GET {{base}}/api/withdraw/my
Authorization: Bearer {{userToken}}

###

### 16.3 Admin views all withdrawals
GET {{base}}/api/withdraw
Authorization: Bearer {{adminToken}}

###

### 16.4 Admin approves withdrawal
PUT {{base}}/api/withdraw/1/status
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "status": "Approved"
}

###

### 16.5 Admin rejects withdrawal
PUT {{base}}/api/withdraw/1/status
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "status": "Rejected"
}

###


# ============================================================
# 17. NOTIFICATIONS  (/api/notifications)
# ============================================================

### 17.1 Create notification
POST {{base}}/api/notifications/create
Content-Type: application/json

{
  "user_id": 1,
  "title": "Test Notification",
  "message": "This is a test notification",
  "type": "order"
}

###

### 17.2 Get all notifications (requires user_id query param)
GET {{base}}/api/notifications/notifications?user_id=1

###

### 17.3 Get my notifications (authenticated)
GET {{base}}/api/notifications/my
Authorization: Bearer {{userToken}}

###

### 17.4 Mark notification as read
PUT {{base}}/api/notifications/my/1/read
Authorization: Bearer {{userToken}}

###

### 17.5 Mark all notifications as read
PUT {{base}}/api/notifications/my/read-all
Authorization: Bearer {{userToken}}

###


# ============================================================
# 18. CHAT  (/api/chat)
# ============================================================

### 18.1 Send message
POST {{base}}/api/chat/send
Content-Type: application/json

{
  "sender_id": 1,
  "sender_role": "buyer",
  "receiver_id": 2,
  "receiver_role": "seller",
  "message": "Hello, is this product available?"
}

###

### 18.2 Get chat history
GET {{base}}/api/chat/history/1/buyer/2/seller

###

### 18.3 Get unread messages for user
GET {{base}}/api/chat/unread/1

###

### 18.4 Mark message as read
PUT {{base}}/api/chat/mark-as-read/1

###

### 18.5 Delete message
DELETE {{base}}/api/chat/delete/1

###


